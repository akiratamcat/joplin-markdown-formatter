{
    "manifest_version": 1,
    "id": "com.akiratamcat.joplin-markdown-formatter-i18n",
    "app_min_version": "3.5",
    "version": "1.6.12",
    "platforms": ["desktop", "mobile"],
    "name": "Markdown Formatter (i18n test)",
    "description": "Reformat/Normalize markdown with some configurable settings. Unofficial test build with translated UI (gettext PO).",
    "author": "bwat47, akiratamcat",
    "homepage_url": "https://github.com/akiratamcat/joplin-markdown-formatter",
    "repository_url": "https://github.com/akiratamcat/joplin-markdown-formatter",
