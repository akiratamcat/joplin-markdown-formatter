msgstr ""

msgid "2 spaces"
msgstr ""

msgid "4 spaces"
msgstr ""

msgid "List indentation"
msgstr ""

msgid "Preferred indentation before nested list markers. It may be widened to preserve CommonMark nesting; for example, 2 spaces becomes 3 beneath `1.` and 4 beneath `10.`."
msgstr ""

